# Replace with your FastAPI server address.
# If running on a physical device, use your machine's LAN IP (e.g., http://192.168.1.100:8000)
# If running in simulator, use http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# MapTiler API key for map tiles
EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_api_key
