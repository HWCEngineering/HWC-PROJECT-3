{
  "name": "hwc-photo-log",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "assets:sync": "node scripts/sync-assets.mjs",
    "dev": "npm run dev:web & npm run dev:api",
    "dev:web": "npm --workspace=@hwc/web run dev",
    "dev:api": "python -m uvicorn main:app --reload --app-dir apps/api",
    "dev:mobile": "npm --workspace=@hwc/mobile run start",
    "build": "npm --workspace=@hwc/web run build",
    "preview": "npm --workspace=@hwc/web run preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "overrides": {
    "@hwc/mobile": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
